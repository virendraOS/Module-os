# ==============================================================================
# Xelvion Innova Tech - Environment Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# Email Delivery Configuration (Nodemailer in server.ts)
# Option A: Gmail SMTP (Recommended - uses a 16-character Google App Password)
# ------------------------------------------------------------------------------
# 1. Enable 2-Step Verification on your Google Account:
#    https://myaccount.google.com/signinoptions/two-step-verification
# 2. Create an App Password:
#    https://myaccount.google.com/apppasswords
GMAIL_USER="your-email@gmail.com"
GMAIL_APP_PASSWORD="your-16-char-app-password"

# Destination inbox where website inquiries will be delivered:
INQUIRY_TO="skylarkvirendra@gmail.com"
# Optional CC address:
# INQUIRY_CC="virendrasinghrawaat@gmail.com"

# ------------------------------------------------------------------------------
# Option B: Custom SMTP Server (Use instead of Gmail if using Zoho, Hostinger, etc.)
# ------------------------------------------------------------------------------
# SMTP_HOST="smtp.example.com"
# SMTP_PORT="465"
# SMTP_SECURE="true"
# SMTP_USER="noreply@example.com"
# SMTP_PASS="your-smtp-password"
# SMTP_FROM="Xelvion Inquiries <noreply@example.com>"

# ------------------------------------------------------------------------------
# System & Deployment Variables
# ------------------------------------------------------------------------------
PORT="3000"
NODE_ENV="development"
APP_URL="http://localhost:3000"
GEMINI_API_KEY="MY_GEMINI_API_KEY"
